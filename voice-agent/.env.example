# --- Transport (Daily.co WebRTC rooms) ---
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1

# --- STT ---
DEEPGRAM_API_KEY=

# --- LLM (reuse the same OpenRouter account the Node backend uses) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VOICE_LLM_MODEL=anthropic/claude-haiku-4.5

# --- TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Service ---
PORT=7860
# Comma-separated origins allowed to request a session (your Next.js frontend)
FRONTEND_URL=http://localhost:3000
# Shared secret the Node backend attaches when minting a session on a user's behalf
INTERNAL_SERVICE_TOKEN=

# Node backend, reachable from inside this Docker container. On Docker
# Desktop (Windows/Mac) host.docker.internal resolves to the host machine
# where the Node backend runs natively.
NODE_BACKEND_URL=http://host.docker.internal:5000/api
