generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  userRoles UserRole[]
}


model UserRole {
  id        Int       @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model User {
  id                            Int                 @id @default(autoincrement())
  firstName                     String
  lastName                      String
  email                         String              @unique
  phoneNumber                   String?             @unique
  password                      String
  authProvider                  AuthProvider        @default(LOCAL)
  googleId                      String?
  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  passwordResetOtpHash          String?
  passwordResetOtpExpiresAt     DateTime?
  isGuideTaken                  Boolean             @default(false)
  isActive                      Boolean             @default(true)
  isVerified                    Boolean             @default(false)
  isDeleted                     Boolean             @default(false)
  profileImage                  String?
  timezone                      String              @default("Asia/Kolkata")
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  deletedAt                     DateTime?
  chats                         Chat[]
  contexts                      ContextMemory[]
  folders                       Folder[]
  usageLogs                     UsageLog[]
  subscriptions                 Subscription[]
  userWallet                    UserWallet?
  creditWallet                  CreditWallet?
  userRoles                     UserRole[]
  preference                    UserPreference?
  walletTransactions            WalletTransaction[]
  creditTransactions            CreditTransaction[]
  generatedDocuments            GeneratedDocument[]
  generatedVideos               GeneratedVideo[]
  payments                      Payment[]
  invoices                      Invoice[]
  supportRequests               SupportRequest[]
}

model UserPreference {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  enableFollowUpQuestions Boolean  @default(true)
  // Null means "use the voice-agent's env-configured default" — see
  // ELEVENLABS_DEFAULT_VOICE_ID fallback in voice-agent/src/bot.py.
  voiceId                 String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id])
}

enum ContextType {
  GLOBAL
  FOLDER
  CUSTOM
}

enum ContextOrigin {
  USER
  SYSTEM
  DISTILLED
}

model ContextMemory {
  id              Int           @id @default(autoincrement())
  userId          Int
  folderId        Int?
  type            ContextType   @default(CUSTOM)
  title           String
  memory          String
  priority        Int           @default(0)
  isAutoSelected  Boolean       @default(false)
  isAutoGenerated Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  origin          ContextOrigin @default(USER)
  sourceChatId    Int?
  chatContexts    ChatContext[]
  folder          Folder?       @relation(fields: [folderId], references: [id])
  sourceChat      Chat?         @relation("ContextSourceChat", fields: [sourceChatId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([folderId])
  @@index([userId, type])
  @@index([sourceChatId])
}



model UserWallet {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  tokensRemaining    Int                 @default(0)
  tokensUsed         Int                 @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  userId      Int
  walletId    Int
  amount      Int
  type        WalletTransactionType
  referenceId String?
  meta        Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id])
  wallet      UserWallet            @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
  @@index([referenceId])
}

// Separate from UserWallet: video-generation spend is billed in credits, not
// tokens. Split into two balances because they reset differently — bundledCredits
// is overwritten to the plan's monthly grant on every renewal, while topupCredits
// only ever increases (pay-as-you-go purchase) and is never reset/expired.
model CreditWallet {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @unique
  bundledCredits Int                 @default(0)
  topupCredits   Int                 @default(0)
  creditsUsed    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id])
  transactions   CreditTransaction[]
}

enum CreditTransactionType {
  CREDIT_BUNDLED
  CREDIT_TOPUP
  DEBIT
}

model CreditTransaction {
  id          Int                    @id @default(autoincrement())
  userId      Int
  walletId    Int
  amount      Int
  type        CreditTransactionType
  referenceId String?
  meta        Json?
  createdAt   DateTime               @default(now())
  user        User                   @relation(fields: [userId], references: [id])
  wallet      CreditWallet           @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
  @@index([referenceId])
}

model Folder {
  id        Int             @id @default(autoincrement())
  name      String
  userId    Int
  isDeleted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  chats     Chat[]
  contexts  ContextMemory[]
  user      User            @relation(fields: [userId], references: [id])
}

model Chat {
  id                 Int                      @id @default(autoincrement())
  title              String?
  userId             Int
  folderId           Int?
  isArchived         Boolean                  @default(false)
  isShared           Boolean                  @default(false)
  isDeleted          Boolean                  @default(false)
  shareId            String?                  @unique
  sharedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  isPinned           Boolean                  @default(false)
  assistantId        Int?
  capability         ModelCapability          @default(STANDARD)
  modelIds           Int[]
  assistant          Assistant?               @relation(fields: [assistantId], references: [id])
  folder             Folder?                  @relation(fields: [folderId], references: [id])
  user               User                     @relation(fields: [userId], references: [id])
  chatContexts       ChatContext[]
  distillationJobs   ContextDistillationJob[]
  distilledContexts  ContextMemory[]          @relation("ContextSourceChat")
  messages           Message[]
  responses          ModelResponse[]
  usageLogs          UsageLog[]
  generatedDocuments GeneratedDocument[]
  generatedVideos    GeneratedVideo[]

  @@index([userId])
  @@index([folderId])
  @@index([assistantId])
  @@index([userId, createdAt])
}

model ChatContext {
  id        Int           @id @default(autoincrement())
  chatId    Int
  contextId Int
  createdAt DateTime      @default(now())
  chat      Chat          @relation(fields: [chatId], references: [id])
  context   ContextMemory @relation(fields: [contextId], references: [id])

  @@unique([chatId, contextId])
  @@index([chatId])
  @@index([contextId])
}

model ContextDistillationJob {
  id        Int                @id @default(autoincrement())
  chatId    Int
  folderId  Int
  status    DistillationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  chat      Chat               @relation(fields: [chatId], references: [id])

  @@index([status])
  @@index([chatId, status])
}

enum GeneratedDocumentFormat {
  PDF
  DOCX
  PPTX
  XLSX
  CSV
}

enum GeneratedDocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model GeneratedDocument {
  id                 Int                     @id @default(autoincrement())
  userId             Int
  chatId             Int?
  messageId          Int?
  // In compare mode one assistant Message owns several ModelResponse rows, so
  // messageId alone cannot say which model's answer this document came from.
  modelResponseId    Int?
  format             GeneratedDocumentFormat @default(PDF)
  status             GeneratedDocumentStatus @default(PENDING)
  title              String
  prompt             String
  sourceText         String?
  spec               Json?
  theme              String                  @default("professional")
  fileName           String?
  fileUrl            String?
  cloudinaryPublicId String?
  fileSize           Int?
  promptTokens       Int                     @default(0)
  completionTokens   Int                     @default(0)
  attempts           Int                     @default(0)
  lastError          String?
  startedAt          DateTime?
  completedAt        DateTime?
  isDeleted          Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  user               User                    @relation(fields: [userId], references: [id])
  chat               Chat?                   @relation(fields: [chatId], references: [id])
  message            Message?                @relation(fields: [messageId], references: [id])
  modelResponse      ModelResponse?          @relation(fields: [modelResponseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([chatId])
  @@index([messageId])
  @@index([modelResponseId])
}

enum GeneratedVideoStatus {
  PENDING
  SUBMITTED
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

model GeneratedVideo {
  id                 Int                  @id @default(autoincrement())
  userId             Int
  chatId             Int?
  messageId          Int?
  modelId            Int
  status             GeneratedVideoStatus @default(PENDING)
  prompt             String
  duration           Int                  @default(4)
  resolution         String               @default("720p")
  aspectRatio        String               @default("16:9")
  firstFrameUrl      String?
  lastFrameUrl       String?
  externalJobId      String?
  reservedTokens     Int
  reservedFromBundled Int                 @default(0)
  reservedFromTopup  Int                  @default(0)
  actualCostUsd      Decimal?
  fileUrl            String?
  cloudinaryPublicId String?
  thumbnailUrl       String?
  fileSize           Int?
  attempts           Int                  @default(0)
  lastError          String?
  startedAt          DateTime?
  completedAt        DateTime?
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  user               User                 @relation(fields: [userId], references: [id])
  chat               Chat?                @relation(fields: [chatId], references: [id])
  message            Message?             @relation(fields: [messageId], references: [id])
  model              Model                @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([chatId])
  @@index([messageId])
  @@index([externalJobId])
}

model Message {
  id                 Int                 @id @default(autoincrement())
  chatId             Int
  role               MessageRole
  content            String
  editedFromId       Int?
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  chatType           String              @default("STANDARD")
  attachments        Attachment[]
  chat               Chat                @relation(fields: [chatId], references: [id])
  editedFrom         Message?            @relation("MessageEdits", fields: [editedFromId], references: [id])
  editedVersions     Message[]           @relation("MessageEdits")
  modelResponses     ModelResponse[]
  usageLogs          UsageLog[]
  generatedDocuments GeneratedDocument[]
  generatedVideos    GeneratedVideo[]

  @@index([chatId])
  @@index([createdAt])
  @@index([chatId, createdAt])
}

model ModelResponse {
  id                 Int                 @id @default(autoincrement())
  chatId             Int
  messageId          Int
  modelId            Int
  content            String
  promptTokens       Int                 @default(0)
  completionTokens   Int                 @default(0)
  totalTokens        Int                 @default(0)
  status             ResponseStatus      @default(PENDING)
  finishReason       String?
  isLiked            Boolean?
  isStarred          Boolean             @default(false)
  updatedAt          DateTime            @updatedAt
  chat               Chat                @relation(fields: [chatId], references: [id])
  message            Message             @relation(fields: [messageId], references: [id])
  model              Model               @relation(fields: [modelId], references: [id])
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime            @default(now())
  completedAt        DateTime?

  @@index([chatId])
  @@index([messageId])
  @@index([modelId])
  @@index([status])
  @@index([isStarred])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ModelCapability {
  STANDARD
  DEEP_RESEARCH
  IMAGE_GENERATION
  WEB_SEARCH
  VISION
  VOICE
  VIDEO_GENERATION
}

enum ResponseStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

model Model {
  id                     Int               @id @default(autoincrement())
  name                   String
  modelProviderId        Int
  externalId             String
  description            String?
  isActive               Boolean           @default(true)
  isDeleted              Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  capabilities           ModelCapability[] @default([STANDARD])
  defaultForCapabilities ModelCapability[] @default([])
  tokenMultiplier        Float             @default(1.0)
  isFreeModel            Boolean           @default(false)
  videoCostPerSecond     Int?
  videoCostPerSecondByResolution Json?
  videoCostPerSecondByResolutionImageInput Json?
  // Video-credit pricing (the CreditWallet unit, pegged to $0.03/credit —
  // real cost, no multiplier). Independent of the legacy videoCostPerSecond*
  // fields above, which priced video in wallet *tokens* before video moved
  // to its own credit wallet.
  // Float, unlike the legacy videoCostPerSecond* (Int) fields above: credit
  // amounts are small (single/low-double digits), so per-second fractions
  // matter — rounding happens once, on the ceil()'d total for a clip, not on
  // the rate itself (see video.service.ts).
  creditCostPerSecond    Float?
  creditCostPerSecondByResolution Json?
  creditCostPerSecondByResolutionImageInput Json?
  assistants             Assistant[]
  modelProvider          ModelProvider     @relation(fields: [modelProviderId], references: [id])
  responses              ModelResponse[]
  usageLogs              UsageLog[]
  generatedVideos        GeneratedVideo[]
  allowedInPlans         PlanVideoModel[]

  @@unique([modelProviderId, externalId])
}

model Assistant {
  id               Int       @id @default(autoincrement())
  name             String
  slug             String    @unique
  description      String?
  icon             String    @default("Bot")
  systemPrompt     String
  defaultModelId   Int?
  temperature      Float     @default(0.7)
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  greeting         String?
  suggestedPrompts Json?
  bgFrom           String?
  bgTo             String?
  bgVia            String?
  bgFromDark       String?
  bgToDark         String?
  bgViaDark        String?
  defaultModel     Model?    @relation(fields: [defaultModelId], references: [id])
  chats            Chat[]
}

model ModelProvider {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  apiKey      String?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  models      Model[]
}

model Attachment {
  id                 Int      @id @default(autoincrement())
  messageId          Int?
  fileName           String
  fileUrl            String
  mimeType           String
  fileSize           Int
  createdAt          DateTime @default(now())
  cloudinaryPublicId String?
  message            Message? @relation(fields: [messageId], references: [id])
}

model UsageLog {
  id                       Int             @id @default(autoincrement())
  userId                   Int
  modelId                  Int
  chatId                   Int?
  promptTokens             Int
  completionTokens         Int
  totalTokens              Int
  createdAt                DateTime        @default(now())
  capability               ModelCapability @default(STANDARD)
  billableCompletionTokens Int             @default(0)
  billablePromptTokens     Int             @default(0)
  billableTotalTokens      Int             @default(0)
  messageId                Int?
  groupId                  String?         @default(cuid())
  chat                     Chat?           @relation(fields: [chatId], references: [id])
  message                  Message?        @relation(fields: [messageId], references: [id])
  model                    Model           @relation(fields: [modelId], references: [id])
  user                     User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([modelId])
  @@index([createdAt])
  @@index([messageId])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([capability, createdAt])
  @@index([groupId])
}

model Plan {
  id                   Int              @id @default(autoincrement())
  name                 String
  monthlyPrice         Decimal
  quarterlyPrice       Decimal
  yearlyPrice          Decimal
  tokenLimit           Int
  features             Json
  // Real, enforced access-control flags — `features` above stays for
  // display-only metadata (support tier, attachments, etc.) but is never
  // branched on in code; these columns are what planAccess.service.ts reads.
  restrictToFreeModels Boolean          @default(false)
  documentGenEnabled   Boolean          @default(true)
  imageGenEnabled      Boolean          @default(false)
  videoGenEnabled      Boolean          @default(false)
  // Bundled video-credit grant applied (overwritten, not incremented) on
  // every renewal — see CreditWallet.bundledCredits.
  monthlyVideoCredits  Int              @default(0)
  isActive             Boolean          @default(true)
  isDeleted            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?
  subscriptions        Subscription[]
  allowedVideoModels   PlanVideoModel[]
}

// Which video models a plan may use, e.g. Free -> none, Pro -> Seedance 2.0
// Mini + Veo 3.1 Lite only, Pro Plus -> all (including Seedance 2.0 full).
model PlanVideoModel {
  id      Int   @id @default(autoincrement())
  planId  Int
  modelId Int
  plan    Plan  @relation(fields: [planId], references: [id])
  model   Model @relation(fields: [modelId], references: [id])

  @@unique([planId, modelId])
  @@index([modelId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  planId                 Int
  status                 SubscriptionStatus
  billingCycle           SubscriptionCycle
  autoRenew              Boolean            @default(true)
  startedAt              DateTime
  expiresAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  cashfreeCustomerId     String?
  cashfreeSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  currentPeriodStart     DateTime?
  lastPaymentId          String?
  mandateId              String?
  nextBillingDate        DateTime?
  payments               Payment[]
  plan                   Plan               @relation(fields: [planId], references: [id])
  user                   User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY
  QUARTERLY
}

enum SubscriptionReminderStage {
  D3
  D1
  D0
}

model SubscriptionReminder {
  id             Int                       @id @default(autoincrement())
  userId         Int
  subscriptionId Int
  stage          SubscriptionReminderStage
  sentAt         DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([subscriptionId, stage])
  @@index([userId, stage])
  @@index([subscriptionId])
}

enum PaymentType {
  ONE_TIME
  RECURRING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentPurpose {
  SUBSCRIPTION
  CREDIT_TOPUP
}

model Payment {
  id                     Int            @id @default(autoincrement())
  userId                 Int
  walletId               Int?
  subscriptionId         Int?
  type                   PaymentType
  // Distinguishes a subscription charge from a standalone pay-as-you-go
  // video-credit top-up — the latter has no subscriptionId and its webhook
  // credits CreditWallet.topupCredits instead of activating a Subscription.
  purpose                PaymentPurpose @default(SUBSCRIPTION)
  creditsGranted         Int?
  provider               String         @default("CASHFREE")
  providerOrderId        String?
  providerPaymentId      String?
  providerSubscriptionId String?
  amount                 Decimal
  currency               String         @default("INR")
  status                 PaymentStatus  @default(PENDING)
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  invoice                Invoice?
  subscription           Subscription?  @relation(fields: [subscriptionId], references: [id])
  user                   User           @relation(fields: [userId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([providerOrderId])
  @@index([subscriptionId])
}

// Single-row, admin-editable config for pay-as-you-go video-credit top-ups.
// Kept out of code as a constant so pricing can be tuned without a deploy.
// Pay-as-you-go top-up pricing. costPerCreditInr is the RAW cost basis (no
// margin) — a top-up's rupee amount is de-taxed, has marginPercent taken off
// the top as margin, and only what's left converts to credits at cost. This
// keeps top-up margin explicit and independently tunable from whatever
// margin is implied by a subscription plan's bundled credit grant.
model CreditPricingConfig {
  id                Int      @id @default(autoincrement())
  costPerCreditInr  Decimal?
  marginPercent     Decimal  @default(15)
  gstPercent        Decimal  @default(18)
  updatedAt         DateTime @updatedAt
}

enum InvoiceStatus {
  PENDING
  GENERATED
  FAILED
}

model Invoice {
  id            Int           @id @default(autoincrement())
  paymentId     Int           @unique
  userId        Int
  invoiceNumber String        @unique
  invoiceUrl    String?
  amount        Decimal
  currency      String        @default("INR")
  status        InvoiceStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  payment       Payment       @relation(fields: [paymentId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum SupportRequestType {
  TICKET
  CONTACT
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportRequest {
  id        Int                  @id @default(autoincrement())
  userId    Int?
  type      SupportRequestType
  name      String
  email     String
  category  String?
  subject   String
  message   String
  status    SupportRequestStatus @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User?                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([email])
}

model BillingWebhookEvent {
  id           Int                @id @default(autoincrement())
  provider     String             @default("CASHFREE")
  eventType    String
  payloadHash  String             @unique
  rawBody      String
  status       WebhookEventStatus @default(RECEIVED)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([eventType])
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum DistillationStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
