// ─────────────────────────────────────────────────────────────────────────────
// Enterprise / Business organizations (see ENTERPRISE_ORG_PLAN.md).
// Every seat is a normal User with its own UserWallet/CreditWallet; the org
// only funds those wallets and governs access via OrgRole. Org admins see
// usage metrics only nothing here links to chat/message content.
// ─────────────────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrgBillingMode {
  CASHFREE
  MANUAL_INVOICE
}

model Organization {
  id                  Int               @id @default(autoincrement())
  name                String
  slug                String            @unique
  gstin               String?
  billingEmail        String
  billingAddress      Json?
  status              OrgStatus         @default(ACTIVE)
  // Empty = any email domain may be invited.
  allowedEmailDomains String[]
  createdByAdminId    Int
  demoRequestId       Int?              @unique
  isDeleted           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  roles               OrgRole[]
  members             OrgMember[]
  invites             OrgInvite[]
  subscriptions       OrgSubscription[]
  auditLogs           OrgAuditLog[]
  usageLogs           UsageLog[]
  payments            Payment[]
  invoices            Invoice[]
  bills               OrgBill[]

  @@index([status])
}

// Admin-defined role = the policy applied to every member holding it.
model OrgRole {
  id                   Int          @id @default(autoincrement())
  orgId                Int
  name                 String
  description          String?
  isDefault            Boolean      @default(false)
  monthlyTokens        Int          @default(0)
  monthlyVideoCredits  Int          @default(0)
  imageGenEnabled      Boolean      @default(false)
  documentGenEnabled   Boolean      @default(true)
  videoGenEnabled      Boolean      @default(false)
  codeWorkspaceEnabled Boolean      @default(false)
  voiceEnabled         Boolean      @default(false)
  // {"mode":"ALL"|"ALLOWLIST"|"BLOCKLIST","modelIds":[...]}
  modelPolicy          Json         @default("{\"mode\":\"ALL\",\"modelIds\":[]}")
  videoModelIds        Int[]
  dailyTokenCap        Int?
  perRequestTokenCap   Int?
  isDeleted            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [orgId], references: [id])
  members              OrgMember[]
  invites              OrgInvite[]

  @@unique([orgId, name])
  @@index([orgId])
}

model OrgMember {
  id             Int             @id @default(autoincrement())
  orgId          Int
  // One org per user.
  userId         Int             @unique
  memberRole     OrgMemberRole   @default(MEMBER)
  orgRoleId      Int
  status         OrgMemberStatus @default(ACTIVE)
  seatAssignedAt DateTime        @default(now())
  suspendedAt    DateTime?
  removedAt      DateTime?
  // One-off extra tokens granted by an admin for the current period.
  tokenBonus     Int             @default(0)
  // false = a manage-only admin/owner: no seat used, no org tokens or role
  // limits. Plain members always take a seat.
  takesSeat      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [orgId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  role           OrgRole         @relation(fields: [orgRoleId], references: [id])

  @@index([orgId, status])
  @@index([orgRoleId])
}

model OrgInvite {
  id              Int           @id @default(autoincrement())
  orgId           Int
  email           String
  orgRoleId       Int
  memberRole      OrgMemberRole @default(MEMBER)
  takesSeat       Boolean       @default(true)
  // sha256 of the emailed token; the raw token is never stored.
  tokenHash       String        @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId Int?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [orgId], references: [id])
  role            OrgRole       @relation(fields: [orgRoleId], references: [id])

  @@index([orgId])
  @@index([email])
}

model OrgSubscription {
  id                     Int                @id @default(autoincrement())
  orgId                  Int
  planId                 Int
  status                 SubscriptionStatus @default(PENDING)
  billingMode            OrgBillingMode
  billingCycle           SubscriptionCycle  @default(MONTHLY)
  seatsPurchased         Int
  minSeats               Int                @default(1)
  // Snapshot at purchase time never re-derived from a live price.
  pricePerSeat           Decimal
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextBillingDate        DateTime?
  cashfreeSubscriptionId String?            @unique
  // {"seats": n, "effectiveAt": ISO} reduction applied at renewal.
  pendingSeatChange      Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [orgId], references: [id])
  plan                   Plan               @relation(fields: [planId], references: [id])
  bills                  OrgBill[]

  @@index([orgId, status])
}

// Admin ACTIONS only (invites, role edits, seat changes, quota grants, billing).
model OrgAuditLog {
  id           Int          @id @default(autoincrement())
  orgId        Int
  actorUserId  Int
  action       String
  targetType   String?
  targetId     String?
  meta         Json?
  ip           String?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

enum OrgBillKind {
  INITIAL
  RENEWAL
  SEAT_ADD
}

enum OrgBillStatus {
  DUE
  PAID
  VOID
}

// A tax invoice for an organization. Amounts are snapshots taken when the bill
// is created (price, GST rate, seats) and never re-derived. `seats` is the
// seat total the org will have once the bill is paid.
model OrgBill {
  id                Int             @id @default(autoincrement())
  orgId             Int
  orgSubscriptionId Int
  number            String          @unique
  kind              OrgBillKind
  status            OrgBillStatus   @default(DUE)
  seats             Int
  pricePerSeat      Decimal
  months            Int
  periodStart       DateTime
  periodEnd         DateTime
  baseAmount        Decimal
  taxPercent        Decimal
  taxAmount         Decimal
  totalAmount       Decimal
  currency          String          @default("INR")
  // Renewal: the day the paid period ends. Seat additions: when it was raised.
  dueDate           DateTime
  paidAt            DateTime?
  // "CASHFREE" | "BANK_TRANSFER"
  paymentMethod     String?
  // Bank reference / UTR entered by the platform admin, or the Cashfree payment id.
  paymentReference  String?
  providerOrderId   String?
  invoiceUrl        String?
  reminderCount     Int             @default(0)
  // Proration details etc.
  meta              Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [orgId], references: [id])
  subscription      OrgSubscription @relation(fields: [orgSubscriptionId], references: [id])

  @@index([orgId, status])
  @@index([orgSubscriptionId, kind])
  @@index([providerOrderId])
}
