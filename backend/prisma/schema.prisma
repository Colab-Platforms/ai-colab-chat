// ---------------------------------------------------------------------------
// GitHub integration. A CodeProject can be mirrored to a GitHub repo: every
// CodeProjectVersion becomes a commit. GitHub is a mirror, never the source of
// truth - CodeFile rows stay authoritative, and everything below is optional.
// See src/modules/github/README.md.
// ---------------------------------------------------------------------------
model GithubConnection {
  id                    Int              @id @default(autoincrement())
  userId                Int              @unique
  // GitHub App installation. String, not BigInt - BigInt breaks JSON.stringify.
  installationId        String
  accountLogin          String
  // User | Organization
  accountType           String           @default("User")
  accountAvatarUrl      String?
  // User-to-server token (ghu_) + refresh (ghr_), AES-256-GCM via utils/crypto.
  // Null when the App is configured without user authorization.
  userTokenEnc          String?          @db.Text
  userTokenExpiresAt    DateTime?
  refreshTokenEnc       String?          @db.Text
  refreshTokenExpiresAt DateTime?
  // Cleared by the installation.deleted webhook instead of a hard delete.
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id])
  links                 GithubRepoLink[]

  @@index([installationId])
}

model GithubRepoLink {
  id                Int              @id @default(autoincrement())
  projectId         Int              @unique
  connectionId      Int
  repoId            String
  owner             String
  repo              String
  branch            String           @default("main")
  htmlUrl           String
  isPrivate         Boolean          @default(true)
  // Whether an AI turn auto-commits. Manual edits always need the Push button.
  autoPush          Boolean          @default(true)
  lastCommitSha     String?
  lastPushedVersion Int?
  lastSyncedAt      DateTime?
  // IDLE | SYNCING | ERROR - polled by the header button.
  syncState         String           @default("IDLE")
  lastError         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  project           CodeProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection        GithubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}


// ---------------------------------------------------------------------------
// Vercel integration. A CodeProject can be published to the user's own Vercel
// account, either from the CodeFile rows directly or from a linked GitHub repo.
// Vercel is a destination, never a source of truth - nothing is ever pulled
// back, and a server with no VERCEL_* vars hides the feature entirely.
// See src/modules/vercel/README.md.
// ---------------------------------------------------------------------------
model VercelConnection {
  id               Int                 @id @default(autoincrement())
  userId           Int                 @unique
  // Integration install id (icfg_...). Needed to revoke on disconnect.
  configurationId  String
  vercelUserId     String
  // Non-null when installed onto a Team: every API call must then carry
  // ?teamId=<this>, or Vercel answers 403.
  teamId           String?
  // Display only - the account/team shown in the dropdown and dashboard links.
  accountName      String?
  accountSlug      String?
  accountAvatarUrl String?
  // Long-lived Bearer token, AES-256-GCM via utils/crypto. Vercel has no
  // refresh flow - a rejected token means the user must reconnect.
  accessTokenEnc   String              @db.Text
  // Cleared (not deleted) when Vercel reports the integration disabled/revoked.
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  links            VercelProjectLink[]

  @@index([configurationId])
}

model VercelProjectLink {
  id                  Int                @id @default(autoincrement())
  projectId           Int                @unique
  connectionId        Int
  vercelProjectId     String
  vercelProjectName   String
  source              String             @default("FILES")
  framework           String?
  buildCommand        String?
  installCommand      String?
  outputDirectory     String?
  rootDirectory       String?
  devCommand          String?
  nodeVersion         String?
  gitRepoId           String?
  gitOwner            String?
  gitRepo             String?
  gitBranch           String?
  productionUrl       String?
  lastDeploymentId    String?
  lastDeploymentUrl   String?
  lastDeployState     String             @default("IDLE")
  lastDeployedVersion Int?
  lastDeployedAt      DateTime?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             CodeProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection          VercelConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deployments         VercelDeployment[]

  @@index([connectionId])
}

model VercelDeployment {
  id                 Int               @id @default(autoincrement())
  linkId             Int
  projectId          Int
  vercelDeploymentId String            @unique
  source             String            @default("FILES")
  target             String            @default("production")
  readyState         String            @default("QUEUED")
  url                String?
  aliasUrl           String?
  branch             String?
  commitSha          String?
  version            Int?
  fileCount          Int?
  logTail            String?           @db.Text
  errorMessage       String?
  startedAt          DateTime          @default(now())
  finishedAt         DateTime?
  link               VercelProjectLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  project            CodeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([linkId])
}

